# ============================================================================
# Sakhi Frontend — Public Build-Time Environment Variables
# ============================================================================
# IMPORTANT:
# 1. All VITE_* variables are embedded into the static JavaScript bundle at
#    build time and are publicly visible in the browser.
# 2. NEVER place API secrets, Firebase Admin keys, Gemini keys, or private
#    credentials in this file.
# 3. Changing VITE_API_BASE_URL requires rebuilding the Docker image.
# ============================================================================

# Public HTTPS base URL of the deployed Sakhi FastAPI backend (no trailing slash).
# Local dev: http://localhost:8080
# Cloud Run:
VITE_API_BASE_URL=https://backend-service-727289315493.asia-south1.run.app

# Optional environment label (development | staging | production)
VITE_APP_ENV=production
